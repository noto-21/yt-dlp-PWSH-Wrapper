#!/usr/bin/env bash

set -euo pipefail

# -----------------------------
# Args
# -----------------------------
URL=""
DEST="${HOME}/Videos"
AUDIO=0
UPDATE=0
CONFIG_PATH=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--url)
            URL="$2"
            shift 2
            ;;
        -d|--dest)
            DEST="$2"
            shift 2
            ;;
        -a|--audio)
            AUDIO=1
            shift
            ;;
        --update)
            UPDATE=1
            shift
            ;;
        -c|--config)
            CONFIG_PATH="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1"
            exit 1
            ;;
    esac
done

if [[ -z "$CONFIG_PATH" ]]; then
    echo "Config path is required (-c)"
    exit 1
fi

# -----------------------------
# Load config (JSON via jq)
# -----------------------------
if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required for config parsing"
    exit 1
fi

CONFIG_RAW="$(cat "$CONFIG_PATH")"

BINARY_PATH="$(jq -r '.binaryPath' <<< "$CONFIG_RAW")"
FFMPEG_PATH="$(jq -r '.ffmpegPath' <<< "$CONFIG_RAW")"
JSRUNTIME_PATH="$(jq -r '.jsruntimePath' <<< "$CONFIG_RAW")"
VIDEO_SETTINGS="$(jq -r '.videoSettings' <<< "$CONFIG_RAW")"
AUDIO_SETTINGS="$(jq -r '.audioSettings' <<< "$CONFIG_RAW")"
LOG_FILE="$(jq -r '.logFile' <<< "$CONFIG_RAW")"

# Expand environment variables in config values
expand_vars () {
    eval echo "$1"
}

JSRUNTIME_PATH="$(expand_vars "$JSRUNTIME_PATH")"
LOG_FILE="$(expand_vars "$LOG_FILE")"

mkdir -p "$(dirname "$LOG_FILE")"

# -----------------------------
# Logging
# -----------------------------
exec > >(tee -a "$LOG_FILE") 2>&1

echo "----------------------------------------"
echo "yt-dlp wrapper started: $(date)"
echo "URL: $URL"
echo "DEST: $DEST"

# -----------------------------
# Ensure destination exists
# -----------------------------
mkdir -p "$DEST"

# -----------------------------
# Playlist detection
# -----------------------------
if [[ "$URL" == *"list="* ]]; then
    USING_PLAYLIST=1
else
    USING_PLAYLIST=0
fi

# -----------------------------
# Output template
# -----------------------------
if [[ "$USING_PLAYLIST" -eq 1 ]]; then
    OUTPUT_TEMPLATE="${DEST}/%(playlist_title)s/%(playlist_index)s - %(title)s.%(ext)s"
else
    OUTPUT_TEMPLATE="${DEST}/%(title)s.%(ext)s"
fi

# -----------------------------
# Build yt-dlp args
# -----------------------------
ARGS=(
    "$URL"
    "-o" "$OUTPUT_TEMPLATE"
    "--ffmpeg-location" "$FFMPEG_PATH"
    "--js-runtimes" "$JSRUNTIME_PATH"
)

if [[ "$AUDIO" -eq 1 ]]; then
    ARGS+=(
        "-x"
        "--audio-format" "$AUDIO_SETTINGS"
    )
else
    ARGS+=(
        "-f" "$VIDEO_SETTINGS"
    )
fi

# -----------------------------
# Update binary
# -----------------------------
update_binary () {
    echo "Updating yt-dlp..."
    "$BINARY_PATH" -U
}

if [[ "$UPDATE" -eq 1 ]]; then
    update_binary
fi

# -----------------------------
# Download with retry logic
# -----------------------------
YT_RETRY_ATTEMPT=0

run_download () {
    "$BINARY_PATH" "${ARGS[@]}"
}

set +e
run_download
EXIT_CODE=$?
set -e

if [[ "$EXIT_CODE" -ne 0 ]]; then
    if [[ "$YT_RETRY_ATTEMPT" -eq 1 ]]; then
        echo "Download failed after update attempt."
        exit 1
    fi

    echo "Download failed. Updating yt-dlp and retrying..."
    update_binary

    YT_RETRY_ATTEMPT=1
    run_download
    EXIT_CODE=$?

    if [[ "$EXIT_CODE" -ne 0 ]]; then
        echo "Download failed after retry."
        exit 1
    fi
fi

echo "Download complete."
echo "Saved to: $DEST"
